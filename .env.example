# Embeddings
# EMBEDDING_PROVIDER=openrouter uses OpenRouter. EMBEDDING_PROVIDER=ollama uses local Ollama.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_DIMENSIONS=1536
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
# Docker Compose uses host.docker.internal to reach Ollama on your host.
# Use http://127.0.0.1:11434 when running npm start outside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenRouter metadata extraction (optional but recommended)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Postgres (pgvector)
DATABASE_URL=postgresql://openmind:openmind@localhost:5432/openmind

# API Server
API_PORT=3333
# Public URL used in MCP search/fetch citation links.
OPENMIND_PUBLIC_URL=https://theopenmind.pro

# Web Dashboard Authentication (initial admin credentials)
WEBUI_USER=admin
WEBUI_PASSWORD=openmind

# Session Security (auto-generated if omitted, but sessions are lost on restart)
JWT_SECRET=

# Optional MCP Registry HTTP namespace verification.
# Value format: v=MCPv1; k=ed25519; p=PUBLIC_KEY
MCP_REGISTRY_AUTH=
